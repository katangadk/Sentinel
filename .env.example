# Local development only. Change BOTH values before public deployment.
SENTINEL_DEVELOPMENT=true
SENTINEL_PUBLIC_ORIGIN=http://localhost:3100
SENTINEL_API_PORT=8100
SENTINEL_FRONTEND_PORT=3100
SENTINEL_DATABASE_URL=sqlite:///./data/sentinel.db
# Used by Next.js at build time for local API rewrites.
SENTINEL_BACKEND_URL=http://127.0.0.1:8100
# Generate once: .venv/bin/python scripts/generate-vapid.py
# Use absolute path to private.pem in production. No keys are shipped.
SENTINEL_VAPID_PRIVATE_KEY=
SENTINEL_VAPID_PUBLIC_KEY=
SENTINEL_VAPID_SUBJECT=mailto:your-address@example.com
# Backend only. Never use NEXT_PUBLIC_ variables for this key.
GOOGLE_GEOLOCATION_API_KEY=
# All Google attempts (including failures), shared across enrolled devices/gateways.
SENTINEL_GOOGLE_DAILY_LIMIT=144
SENTINEL_GOOGLE_LOCATION_TTL_SECONDS=86400
# Leave false unless Google separately authorizes accuracy-radius caching.
SENTINEL_GOOGLE_ACCURACY_CACHE_AUTHORIZED=false
